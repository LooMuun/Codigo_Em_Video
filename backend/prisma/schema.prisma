generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String       @id @default(uuid())
  email       String       @unique
  name        String?
  password    String
  img         String?
  role        Role         @default(USER)
  createdAt   DateTime     @default(now())
  progress    Progress[]
  ratings     Rating[]
  quizAnswers QuizAnswer[]
  aiUsage     AiUsage[]   
}

model Module {
  id          String      @id @default(uuid())
  title       String
  description String
  img         String
  createdAt   DateTime    @default(now())
  classrooms  Classroom[]
  ratings     Rating[]
}

model Classroom {
  id          String       @id @default(uuid())
  title       String
  description String
  url         String
  img         String
  moduleId    String
  module      Module       @relation(fields: [moduleId], references: [id])
  questions   Question[]
  progress    Progress[]
}

model Question {
  id          String       @id @default(uuid())
  statement   String
  classroomId String
  classroom   Classroom    @relation(fields: [classroomId], references: [id])
  options     Option[]
  quizAnswers QuizAnswer[]
}

model Option {
  id          String       @id @default(uuid())
  option      String
  isCorrect   Boolean      @default(false)
  questionId  String
  question    Question     @relation(fields: [questionId], references: [id])
  quizAnswers QuizAnswer[]
}

model Progress {
  id          String    @id @default(uuid())
  userId      String
  classroomId String
  completed   Boolean   @default(false)
  completedAt DateTime?
  user        User      @relation(fields: [userId], references: [id])
  classroom   Classroom @relation(fields: [classroomId], references: [id])

  @@unique([userId, classroomId])
}

model Rating {
  id        String   @id @default(uuid())
  userId    String
  moduleId  String
  score     Int
  comment   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  module    Module   @relation(fields: [moduleId], references: [id])

  @@unique([userId, moduleId])
}

model QuizAnswer {
  id         String   @id @default(uuid())
  userId     String
  questionId String
  optionId   String
  isCorrect  Boolean
  answeredAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
  question   Question @relation(fields: [questionId], references: [id])
  option     Option   @relation(fields: [optionId], references: [id])

  @@unique([userId, questionId])
}

model AiUsage {
  id        String   @id @default(uuid())
  userId    String
  date      String   
  count     Int      @default(0)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

enum Role {
  ADMIN
  USER
}